SECRET_KEY=change-this-to-something-random

# DB_ENGINE controls which database backend is used.
#   sqlite   (default) -> zero setup, stores data in instance/consultmeet.db,
#                          just for local testing, no server needed.
#   postgres           -> use this in production (e.g. Supabase on Render).
#   mysql              -> legacy option, still supported.
DB_ENGINE=postgres

# --- Only needed if DB_ENGINE=postgres ---
# Use Supabase's POOLED ("Transaction") connection string, not the direct
# one — find it in Supabase: Project Settings > Database > Connection
# string > "Transaction pooler". It looks like:
#
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# (Supabase's dashboard shows it as postgres://... — that's fine, the app
# rewrites it to postgresql:// automatically.)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# --- Only needed if DB_ENGINE=mysql ---
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=consultmeet
